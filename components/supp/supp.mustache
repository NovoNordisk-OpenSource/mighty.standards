#' @title Add supplemental qualifiers
#' @description
#' Transposes a supplemental qualifier (SUPP--) data set to one column for each QNAM, and merges the columns into
#' the domain by USUBJID and, when `idvar` is given, by the `idvar` variable.
#'
#' @param domain `character` Name of the domain that gets the new columns
#' @param source `character` Name of the SUPP-- data set, for example SUPPAE
#' @param qnam `character` One or more QNAM values to add as columns
#' @param idvar `character` Name of the variable in `domain` that IDVAR refers to, for example AESEQ. Use NULL for
#' subject-level records, where IDVAR is blank. Do not use "".
#' @type column
#' @origin Predecessor
#' @method QVAL from the SUPP-- data set, transposed by QNAM and merged by USUBJID and IDVAR/IDVARVAL
#' @depends {{{domain}}} USUBJID
{{#idvar}}
#' @depends {{{domain}}} {{{idvar}}}
{{/idvar}}
#' @depends {{{source}}} USUBJID
{{#idvar}}
#' @depends {{{source}}} IDVARVAL
{{/idvar}}
#' @depends {{{source}}} QNAM
#' @depends {{{source}}} QVAL
{{#qnam}}
#' @outputs {{{.}}}
{{/qnam}}
#' @code
# Match key for each record: USUBJID, and the IDVARVAL value when idvar is given
{{#idvar}}
supp_id <- {{{source}}}[["IDVARVAL"]]
domain_id <- {{{domain}}}[["{{{idvar}}}"]]
if (is.numeric(domain_id)) {
  # Compare as double on both sides, so that "01" matches 1 and integer and double give the same text
  supp_id <- as.numeric(supp_id)
  domain_id <- as.numeric(domain_id)
}
# "\r" does not occur in USUBJID or IDVARVAL, so the joined key is unique
supp_key <- paste({{{source}}}[["USUBJID"]], supp_id, sep = "\r")
domain_key <- paste({{{domain}}}[["USUBJID"]], domain_id, sep = "\r")
domain_key[is.na(domain_id)] <- NA_character_
{{/idvar}}
{{^idvar}}
supp_key <- {{{source}}}[["USUBJID"]]
domain_key <- {{{domain}}}[["USUBJID"]]
{{/idvar}}

{{#qnam}}
is_qnam <- {{{source}}}[["QNAM"]] %in% "{{{.}}}"
{{{domain}}}[["{{{.}}}"]] <- {{{source}}}[["QVAL"]][is_qnam][match(domain_key, supp_key[is_qnam])]
{{/qnam}}
